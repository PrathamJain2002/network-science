{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "pip install -r requirements-minimal.txt && npm install"
  },
  "deploy": {
    "startCommand": "sh -c 'python -m uvicorn api:app --host 0.0.0.0 --port $PORT & node server.js'",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 100,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
